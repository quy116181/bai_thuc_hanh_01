#include <stdio.h>
#include <stdlib.h>

int timMax(int A[], int n) {
int max = A[0];
for (int i = 1; i < n; i++) {
if (A[i] > max) {
max = A[i];
}
}
return max;
}

int main() {
int n;
printf("Nhap so luong phan tu n: ");
scanf("%d", &n);
if (n <= 0) {
printf("So luong phan tu khong hop le!\n");
return 1;
}
int *A = (int *)malloc(n * sizeof(int));
if (A == NULL) {
printf("Cap phat bo nho that bai!\n");
return 1;
}
printf("Nhap %d so nguyen:\n", n);
for (int i = 0; i < n; i++) {
printf("A[%d] = ", i);
scanf("%d", &A[i]);
}
int giaTriMax = timMax(A, n);
printf("\nSo lon nhat trong mang la: %d\n", giaTriMax);
free(A);
return 0;
}
